# Base URL of the API. Leave as /api: in development Vite proxies it, and in
# production the Cloudflare Pages Function (functions/api) forwards it.
VITE_API_URL=/api
# Shown in the privacy policy and terms (set them before going live).
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=
# Browser error reporting (sentry.io), optional.
VITE_SENTRY_DSN=
