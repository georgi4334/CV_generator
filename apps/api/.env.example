# Copy to .env for local development.
NODE_ENV=development
PORT=3001
# Matches docker-compose.yml. In production this is the Neon connection string.
DATABASE_URL=postgres://cv:cv@localhost:5433/cv_generator
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Where the web app lives (links in emails).
APP_URL=http://localhost:5173
# Production: COOKIE_SECURE=true, TRUST_PROXY=true. Different sites for web and API: COOKIE_SAME_SITE=none.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
# TRUST_PROXY=false
# Apply database migrations automatically when the API starts.
MIGRATE_ON_START=true
# Folder for uploaded images (development).
UPLOAD_DIR=uploads
# AI features: a free key from https://aistudio.google.com/apikey (leave empty to turn AI off).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Try the AI screens without a key (fake answers, development only):
# AI_PROVIDER=mock
