# Copy to .env for local development.
NODE_ENV=development
PORT=3001
# Matches docker-compose.yml. In production this is the Neon connection string.
DATABASE_URL=postgres://cv:cv@localhost:5433/cv_generator
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Where the web app lives (links in emails).
APP_URL=http://localhost:5173
# Production: COOKIE_SECURE=true, TRUST_PROXY=true. Different sites for web and API: COOKIE_SAME_SITE=none.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
# TRUST_PROXY=false
# Apply database migrations automatically when the API starts.
MIGRATE_ON_START=true
# Folder for uploaded images (development).
UPLOAD_DIR=uploads
# AI features: people add their own free key in the app (account menu > AI key), so this is
# optional. A key here is a shared fallback for everyone without one, with a daily limit.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Encrypts the keys people save. Development has a built-in value; production needs its own
# random one (at least 32 characters, e.g. `openssl rand -base64 32`).
# SECRETS_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Try the AI screens without a key (fake answers, development only):
# AI_PROVIDER=mock

# ----- Production (see docs/DEPLOY.md) -----
# STORAGE=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# BREVO_API_KEY=
# MAIL_FROM=
# MAIL_FROM_NAME=Vitae
# SENTRY_DSN=
# Shared with the Cloudflare Pages proxy (at least 32 characters).
# PROXY_SECRET=
